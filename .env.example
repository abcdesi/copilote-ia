# URL publique de l'application (sans slash final)
APP_URL="http://localhost:3000"

# Base de données Postgres
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Auth.js — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me-in-production"

# Chiffrement AES-256-GCM des tokens OAuth au repos.
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=""

# Facultatif si AUTH_SECRET est déjà robuste. Sert à signer les états OAuth anti-CSRF.
OAUTH_STATE_SECRET=""

# Partage de diagnostics publics signés. Peut retomber sur AUTH_SECRET mais un secret dédié est préférable.
DIAGNOSTIC_SHARE_SECRET=""
PILOTZIA_DIAGNOSTIC_SHARE_TTL_DAYS="30"

# Copilote IA réel
ANTHROPIC_API_KEY=""
# Modèle de raisonnement avancé. Laisser vide pour utiliser le modèle par défaut du code.
ANTHROPIC_MODEL_SMART=""

# Garde-fous économiques de l'essai gratuit.
PILOTZIA_TRIAL_DAYS="14"
PILOTZIA_TRIAL_CREDITS="100"
PILOTZIA_TRIAL_COST_CAP_EUR="3"
PILOTZIA_AI_FAST_RESERVE_EUR="0.03"
PILOTZIA_AI_SMART_RESERVE_EUR="0.08"

# Capacité mensuelle des abonnements payants.
# Règle structurelle du moteur : 1 crédit ne peut couvrir plus de 0,01 € de coût variable réservé.
# Les caps EUR sont des barrières dures internes ; les crédits sont l'unité visible côté client.
PILOTZIA_CORE_MONTHLY_CREDITS="700"
PILOTZIA_CORE_COST_CAP_EUR="7"
PILOTZIA_ACTION_MONTHLY_CREDITS="2000"
PILOTZIA_ACTION_COST_CAP_EUR="20"
PILOTZIA_SCALE_MONTHLY_CREDITS="5000"
PILOTZIA_SCALE_COST_CAP_EUR="50"

# Réserves conservatrices pour les opérations réelles. Le moteur remonte automatiquement
# le nombre de crédits au minimum économique nécessaire si une réserve coûte davantage.
PILOTZIA_ACTION_EXECUTION_CREDITS="1"
PILOTZIA_ACTION_EXECUTION_RESERVE_EUR="0.01"
PILOTZIA_AUTOMATION_RUN_CREDITS="1"
PILOTZIA_AUTOMATION_RUN_RESERVE_EUR="0.02"
PILOTZIA_FINANCIAL_AUDIT_RESERVE_EUR="0.50"

# Intelligence admin agrégée. Liste d'emails séparés par des virgules.
# Les vues benchmark masquent les cohortes sous le seuil minimum pour limiter les risques de ré-identification.
PILOTZIA_ADMIN_EMAILS=""
PILOTZIA_BENCHMARK_MIN_COHORT="5"

# Assistance : les tickets sont toujours stockés en base. Ces variables activent en plus
# la notification email vers l'équipe via Resend.
PILOTZIA_SUPPORT_EMAIL=""
PILOTZIA_SUPPORT_FROM_EMAIL=""

# Google OAuth partagé — Workspace + Marketing
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facultatif : force une URI de callback canonique. Sinon APP_URL + /api/integrations/google/callback.
# Cette URI doit être copiée à l'identique dans Google Cloud > OAuth > Authorized redirect URIs.
GOOGLE_REDIRECT_URI=""

# Google Ads API — requis uniquement pour synchroniser Google Ads.
# Le developer token se récupère dans le centre API du compte manager Google Ads.
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Moteur d'exécution réel des automatisations (instance n8n dédiée, invisible pour l'utilisateur).
N8N_API_URL="https://your-instance.up.railway.app"
N8N_API_KEY=""
N8N_CALLBACK_SECRET=""

# Email transactionnel / notifications d'assistance
RESEND_API_KEY=""

# Paiement réel — produits/prix Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Mensuel : Core 79 €, Action 179 €, Scale 399 €
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""
# Annuel : Core 869 €, Action 1 969 €, Scale 4 389 €
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_BUSINESS_ANNUAL=""
# Packs ponctuels : 500 crédits = 29 €, 2 000 = 109 €, 5 000 = 269 €
STRIPE_PRICE_CREDITS_500=""
STRIPE_PRICE_CREDITS_2000=""
STRIPE_PRICE_CREDITS_5000=""

# Futures connexions (architecture prévue, activer fournisseur par fournisseur)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# Vérifie les appels du cron Vercel qui déclenchent les automatisations réelles.
CRON_SECRET=""
