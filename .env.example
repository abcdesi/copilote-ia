# Base de données (Postgres hébergé — Prisma Postgres via Vercel Marketplace en prod)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Auth.js — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me-in-production"

# Optionnel : si présent, le copilote utilise l'API Claude au lieu du moteur mock.
# ANTHROPIC_API_KEY=""

# Moteur d'exécution réel des automatisations (instance n8n dédiée, invisible pour l'utilisateur).
# Sans ces deux variables, les automatisations restent au stade simulé (mock).
# N8N_API_URL="https://your-instance.up.railway.app"
# N8N_API_KEY=""
# N8N_CALLBACK_SECRET=""
# RESEND_API_KEY=""

# Vérifie les appels du cron Vercel (vercel.json) qui déclenche les automatisations
# réelles chaque jour. Vercel ajoute automatiquement ce header à ses propres appels
# quand la variable est définie sur le projet.
# CRON_SECRET=""
