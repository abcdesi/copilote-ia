# URL publique de l'application (sans slash final)
APP_URL="http://localhost:3000"

# Base de données Postgres
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Auth.js — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me-in-production"

# Chiffrement AES-256-GCM des tokens OAuth au repos.
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=""

# Facultatif si AUTH_SECRET est déjà robuste. Sert à signer les états OAuth anti-CSRF.
OAUTH_STATE_SECRET=""

# Copilote IA réel
ANTHROPIC_API_KEY=""

# Garde-fous économiques de l'essai gratuit.
# Valeurs recommandées au démarrage : coût externe maximal théorique ≈ 3 € / entreprise.
PILOTZIA_TRIAL_DAYS="14"
PILOTZIA_TRIAL_CREDITS="100"
PILOTZIA_TRIAL_COST_CAP_EUR="3"
PILOTZIA_AI_FAST_RESERVE_EUR="0.03"
PILOTZIA_AI_SMART_RESERVE_EUR="0.08"

# Capacité mensuelle des abonnements payants.
# Les crédits sont visibles par le client. Les caps EUR sont des garde-fous internes de marge.
# Ils peuvent être ajustés après observation du coût réel par cohorte sans modifier les prix publics.
PILOTZIA_CORE_MONTHLY_CREDITS="600"
PILOTZIA_CORE_COST_CAP_EUR="8"
PILOTZIA_ACTION_MONTHLY_CREDITS="2000"
PILOTZIA_ACTION_COST_CAP_EUR="18"
PILOTZIA_SCALE_MONTHLY_CREDITS="7000"
PILOTZIA_SCALE_COST_CAP_EUR="45"

# Intelligence admin agrégée. Liste d'emails séparés par des virgules.
# Les vues benchmark masquent les cohortes sous le seuil minimum pour limiter les risques de ré-identification.
PILOTZIA_ADMIN_EMAILS=""
PILOTZIA_BENCHMARK_MIN_COHORT="5"

# Google Workspace — Gmail + Google Calendar
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Moteur d'exécution réel des automatisations (instance n8n dédiée, invisible pour l'utilisateur).
N8N_API_URL="https://your-instance.up.railway.app"
N8N_API_KEY=""
N8N_CALLBACK_SECRET=""

# Email transactionnel / exécution des automatisations
RESEND_API_KEY=""

# Paiement réel — à activer quand les produits/prix Stripe sont créés
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Futures connexions (architecture prévue, activer fournisseur par fournisseur)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# Vérifie les appels du cron Vercel qui déclenchent les automatisations réelles.
CRON_SECRET=""
