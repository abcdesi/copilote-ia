// Pilotzia — schéma de données opérationnel
// Postgres hébergé (Prisma Postgres via Vercel Marketplace) — même schéma qu'en local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  companies Company[]
  events    Event[]
}

model Company {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  industry          String?
  country           String?
  sizeRange         String?
  employeeCount     Int?
  objectives        String?
  painPoints        String?
  businessModel     String?
  customerProfile   String?
  localContext      String?
  financeContext    String?
  marketingContext  String?
  accountingContext String?
  salesContext      String?
  hrContext         String?
  operationsContext String?
  automationScore   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tools                  CompanyTool[]
  diagnostics            Diagnostic[]
  opportunities          Opportunity[]
  automations            Automation[]
  chatMessages           ChatMessage[]
  conversations          Conversation[]
  subscriptions          Subscription[]
  purchases              Purchase[]
  creditPurchases        CreditPurchase[]
  supportRequests        SupportRequest[]
  events                 Event[]
  prospects              Prospect[]
  integrationConnections IntegrationConnection[]
  pendingActions         PendingAction[]
  graphEntities          BusinessEntity[]
  graphFacts             BusinessFact[]
  contextRevisions       CompanyContextRevision[]

  @@index([userId])
}

model CompanyTool {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  detected  Boolean @default(false)

  @@unique([companyId, name])
}

model IntegrationConnection {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider              String
  accountLabel          String?
  externalAccountId     String?
  status                String   @default("connected")
  permissionMode        String   @default("read_action_confirm")
  scopes                 String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  lastSyncedAt          DateTime?
  lastError             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, provider])
  @@index([companyId, status])
}

model PendingAction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider    String
  kind        String
  title       String
  description String
  payloadJson String
  riskLevel   String   @default("medium")
  status      String   @default("pending")
  resultJson  String?
  error       String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  executedAt  DateTime?

  @@index([companyId, status])
  @@index([createdAt])
}

model BusinessEntity {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String
  canonicalKey   String
  name           String
  status         String   @default("active")
  attributesJson String?
  confidence     Float    @default(1)
  sourceCount    Int      @default(1)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subjectFacts BusinessFact[] @relation("BusinessFactSubject")
  objectFacts  BusinessFact[] @relation("BusinessFactObject")

  @@unique([companyId, type, canonicalKey])
  @@index([companyId, type])
  @@index([companyId, status])
}

model BusinessFact {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subjectEntityId String
  subject         BusinessEntity  @relation("BusinessFactSubject", fields: [subjectEntityId], references: [id], onDelete: Cascade)
  predicate       String
  objectEntityId  String?
  object          BusinessEntity? @relation("BusinessFactObject", fields: [objectEntityId], references: [id], onDelete: Cascade)
  valueJson       String?
  sourceProvider  String
  sourceRef       String?
  confidence      Float           @default(1)
  observedAt      DateTime        @default(now())
  expiresAt       DateTime?
  provenanceJson  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId, predicate])
  @@index([subjectEntityId])
  @@index([objectEntityId])
  @@index([companyId, sourceProvider])
}

model CompanyContextRevision {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  section           String
  field             String
  previousValueJson String?
  nextValueJson     String?
  source            String
  effectiveAt       DateTime
  createdAt         DateTime @default(now())

  @@index([companyId, effectiveAt])
  @@index([companyId, section, effectiveAt])
}

model Diagnostic {
  id              String   @id @default(cuid())
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionToken    String?
  rawInput        String
  detectedTools   String
  automationScore Int
  resultJson      String
  claimedAt       DateTime?
  createdAt       DateTime @default(now())

  opportunities Opportunity[]

  @@index([sessionToken])
  @@index([companyId])
}

model Opportunity {
  id                     String      @id @default(cuid())
  companyId              String
  company                Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceDiagnosticId     String?
  sourceDiagnostic       Diagnostic? @relation(fields: [sourceDiagnosticId], references: [id])
  templateId             String
  title                  String
  description            String
  category               String
  impactLevel            String
  complexity             String
  estimatedHoursPerMonth Float
  estimatedValueEur      Float
  priceEur               Float
  status                 String      @default("detected")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  automations Automation[]
  purchases   Purchase[]

  @@index([companyId])
}

model Automation {
  id                     String       @id @default(cuid())
  companyId              String
  company                Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId          String?
  opportunity            Opportunity? @relation(fields: [opportunityId], references: [id])
  templateId             String?
  name                   String
  businessGoal           String
  status                 String       @default("active")
  health                 String       @default("green")
  toolsUsed              String
  installedAt            DateTime     @default(now())
  lastCheckedAt          DateTime     @default(now())
  lastModifiedAt         DateTime     @default(now())
  estimatedHoursPerMonth Float
  estimatedValueEur      Float
  usageCount             Int          @default(0)
  errorCount             Int          @default(0)
  createdAt              DateTime     @default(now())
  n8nWorkflowId          String?
  messageSubject         String?
  messageBody            String?

  feedback AutomationFeedback[]
  runs     AutomationRun[]

  @@index([companyId])
}

model AutomationRun {
  id             String     @id @default(cuid())
  automationId   String
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status         String
  source         String     @default("scheduled")
  itemsProcessed Int        @default(0)
  durationMs     Int?
  errorCode      String?
  metadata       String?
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?

  @@index([automationId, startedAt])
  @@index([status])
}

model Prospect {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId      String   @default("relance-prospects")
  name            String
  email           String
  lastContactedAt DateTime?
  status          String   @default("active")
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([companyId, templateId])
}

model AutomationFeedback {
  id               String     @id @default(cuid())
  automationId     String
  automation       Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  sentiment        String
  timeSavedPerWeek Float?
  createdAt        DateTime   @default(now())

  @@index([automationId])
}

model Conversation {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages ChatMessage[]

  @@index([companyId])
  @@index([companyId, createdAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([companyId])
  @@index([conversationId])
}

model Subscription {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan               String   @default("free")
  status             String   @default("active")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  billingInterval    String?
  stripeCustomerId   String?
  stripeSubId        String?
  createdAt          DateTime @default(now())

  @@index([companyId])
}

model Purchase {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  amountEur     Float
  status        String      @default("pending")
  provider      String      @default("stripe")
  providerRef   String?
  createdAt     DateTime    @default(now())

  @@index([companyId])
}

model CreditPurchase {
  id                      String   @id @default(cuid())
  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  packKey                 String
  credits                 Int
  costBudgetEur           Float
  amountEur               Float
  status                  String   @default("paid")
  stripeCheckoutSessionId String   @unique
  expiresAt               DateTime?
  createdAt               DateTime @default(now())

  @@index([companyId, status, createdAt])
  @@index([expiresAt])
}

model SupportRequest {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requesterEmail String
  category       String
  subject        String
  message        String
  priority       String   @default("normal")
  status         String   @default("open")
  contextJson    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, status, createdAt])
  @@index([status, priority, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  metadata  String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([companyId])
  @@index([createdAt])
}
